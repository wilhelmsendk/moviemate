# Copy to .env. Set a unique password before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Address reachable FROM the container. Include any Jellyfin base path.
JELLYFIN_URL=http://host.docker.internal:8096
# MovieMate never accepts a Jellyfin URL from an untrusted browser.
PORT=3210
# Set true when MovieMate is served over HTTPS (required outside your LAN).
COOKIE_SECURE=false
